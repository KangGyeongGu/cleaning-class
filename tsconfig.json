/**
 * @file tsconfig.json
 * @description TypeScript 엄격 타입 검사·모듈 해석·경로 별칭·검사 대상 파일 설정
 * @activation 직접 실행: npm run typecheck
 * @activation 통합 검사: check:fast, verify, verify:full
 * @activation 앱·IDE: Next.js 개발·빌드, TypeScript 언어 서비스
 * @activation Git Hook: pre-push의 verify
 * @activation Agent Skill: /cut-release
 */
{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "legacy"]
}
